            {
              "id": "hero-copy",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "hero-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Secaucus, NJ · Since 1945",
                    "text": "The Northeast’s heavy truck headquarters",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "hero-text",
                  "type": "text",
                  "props": {
                    "text": "New and pre-owned trucks from Volvo, Western Star, Autocar, BYD and Motiv — plus parts, service, financing and leasing, minutes from the NY metro."
                  }
                },
                {
                  "id": "hero-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "browse-inventory"
                      },
                      {
                        "ctaId": "book-service"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "hero-media",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "hero-img",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "https://www.hudsoncountymotors.com/efs/wp/domains/www.hudsoncountymotors.com/wp-content/uploads/2022/11/WS_57X_72HR_49X_Dump_47X_Mixer_new-image-for-website-landing-page-1024x683.jpg",
