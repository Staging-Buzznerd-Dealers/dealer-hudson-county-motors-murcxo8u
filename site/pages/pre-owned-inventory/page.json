      "props": {
        "sectionId": "faq-band",
        "values": {
          "background": "card",
          "heading": "Expert FAQ Stack",
          "faqs": [
            {
              "q": "How does Hudson County Motors source its pre-owned commercial truck inventory?",
              "a": "We do not rely on unpredictable auction equipment. The vast majority of our pre-owned inventory is sourced directly from trusted regional fleet trade-ins, corporate replacement cycles, and local trucks managed under our contract maintenance programs."
            },
            {
              "q": "What specific warranty protections are provided with your used heavy-duty trucks?",
              "a": "Many trucks still carry remaining manufacturer warranties. For units no longer covered by the original manufacturer warranty, we provide a standard 3-month warranty along with extended warranty options for added protection and peace of mind."
            },
            {
              "q": "How are the aftertreatment and emissions systems verified during your used truck inspections?",
              "a": "Our factory-trained technicians use advanced diagnostic platforms like Premium Tech Tool to execute complete emissions system evaluations, checking the performance, regeneration history, and component integrity of the EGR, DPF, and SCR assemblies."
            },
            {
              "q": "Can fleet buyers access online parts catalogs for pre-owned inventory models?",
              "a": "Yes. Fleet operators can look up parts, verify pricing, and order factory components online by logging into the Volvo Parts Asist catalog or utilizing the Daimler Excelerator portal for Western Star models."
            },
            {
              "q": "How does your trade-in evaluation program assist fleets with vehicle replacement cycles?",
              "a": "Our sales specialists perform fair, transparent equipment evaluations to help fleets rotate older assets out of service. This strategy lowers upfront capital requirements and creates flexible financing terms when upgrading to newer vehicles."
            }
          ]
        },
        "snapshots": {
