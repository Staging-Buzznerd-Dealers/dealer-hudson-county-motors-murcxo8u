    {
      "id": "why-work-here",
      "type": "sharedSection",
      "props": {
        "sectionId": "content-split",
        "values": {
          "background": "none",
          "heading": "Why Work at Hudson County Motors?",
          "body": "We’re a hands-on, team-oriented dealership where people show up, do the work, and support each other. If you’re looking for a place to build a career—not just pass time—this is it.",
          "cards": [
            {
              "num": "01",
              "title": "Family-Owned, Team-Focused",
              "text": "We’re not a corporate chain. We’re a family-owned business where people are known, valued, and part of a team that works together every day."
            },
            {
              "num": "02",
              "title": "Opportunities to Grow",
              "text": "We believe in developing our people. Whether you’re experienced or just getting started, there’s room to learn, take on more responsibility, and grow within the company."
            },
            {
              "num": "03",
              "title": "Work That Matters",
              "text": "Heavy-duty trucks keep industries moving. The work we do is essential, and every role here contributes to keeping our customers on the road."
            },
            {
              "num": "04",
              "title": "Supportive, Straightforward Environment",
              "text": "We value accountability, reliability, and people who take pride in doing their job well. It’s a professional environment where expectations are clear and effort is recognized."
            }
          ],
          "cardSpan": 3
        }
      }
    },
