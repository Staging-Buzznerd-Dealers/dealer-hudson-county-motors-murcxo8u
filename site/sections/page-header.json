{
  "version": 2,
  "id": "page-header",
  "name": "Page header",
  "css": "[data-bz-section=\"page-header\"] { background: var(--card); border-bottom: 1px solid var(--line); padding-block: clamp(40px, 7vw, 72px); }\n[data-bz-node=\"page-header-h\"] h1 { font-size: clamp(36px, 5vw, 60px); line-height: 1; text-wrap: balance; margin-bottom: 0; }\n[data-bz-node=\"page-header-intro\"] p { font-size: clamp(15px, 1.8vw, 18px); line-height: 1.6; max-width: 560px; margin: 22px 0 0; }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": "Hudson County Motors"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Page heading"
    },
    {
      "key": "intro",
      "type": "textarea",
      "label": "Intro",
      "default": ""
    }
  ],
  "nodes": [
    {
      "id": "page-header",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 0
      },
      "children": [
        {
          "id": "page-header-row",
          "type": "row",
          "props": {
            "gap": 0
          },
          "children": [
            {
              "id": "page-header-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "page-header-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "{{eyebrow}}",
                    "text": "{{heading}}",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "page-header-intro",
                  "type": "text",
                  "props": {
                    "text": "{{intro}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
