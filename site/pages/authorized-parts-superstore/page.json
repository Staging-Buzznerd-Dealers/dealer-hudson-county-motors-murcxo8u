    },
    {
      "id": "intro",
      "type": "sharedSection",
      "props": {
        "sectionId": "content-split",
        "values": {
          "background": "none",
          "intro": "Are you a truck enthusiast looking for the best selection of parts and accessories? Look no further than our one-stop shop for heavy trucks. We stock popular brands: Alliance, CAT, Cummins, Detroit, Fleetguard, Meritor, Volvo, Dex and more. We have amazing prices on Volvo truck parts: fuel filters, oil filters, air cylinder kits, tires, truck seats, accessories and more!",
          "infoTitle": "Parts Delivery Service & Store Location",
          "infoText": "Our parts delivery service makes it easier than ever to get the parts you need. We deliver anywhere in the NY/NJ/CT area with same-day delivery available. If you want to pick up your order yourself, we also offer a convenient store location in Secaucus, NJ where you can come by anytime during <a href=\"/map-hours\">regular business hours</a>. Surrounding counties near our retail parts store: Hudson, Essex, Bergen, Union, and Middlesex in northern New Jersey. Our knowledgeable parts sales team is always available to answer any questions you may have. Email us on the link below or call: <a href=\"tel:+12018662716\">201-866-2716</a>",
          "infoCtaLabel": "Email Us",
          "infoCtaUrl": "/contact-us",
          "infoCta2Label": "Order Online",
          "infoCta2Url": "/store/parts"
        }
      }
    },
